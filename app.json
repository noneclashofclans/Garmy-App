{
  "expo": {
    "name": "Garmy",
    "slug": "Garmy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/garmy.png",
    "scheme": "garmyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rishit.garmyapp",
      "adaptiveIcon": {
        "backgroundColor": "#4f5d4e",
        "foregroundImage": "./assets/images/garmy.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4f5d4e",
          "image": "./assets/images/garmy.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "29dcfffb-29fe-4b30-948b-2cde0031b38b"
      }
    }
  }
}